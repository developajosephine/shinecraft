# Copy to .env for local development. Never commit a real .env.
# Values below match docker-compose.yml and are for local use only.

# Server
DATABASE_URL=postgres://washlog:washlog@localhost:5433/washlog
SYNC_TOKEN=change-me        # operator token for scripts/curl only; never sent to browsers
PORT=8080
GIT_SHA=dev
DEMO_MODE=true
# SEED_ON_START=true   # load the synthetic demo data on startup (hosted deployments)
# DEMO_MODE=true also creates the synthetic demo logins (Amani, Baraka, Chiku, Manager; PIN 2468)
# ADMIN_NAME=          # first manager account for a real (non-demo) deployment
# ADMIN_PIN=           # 4 to 8 digits; change it from the Users screen after the first login
# TRUST_PROXY=1        # reverse proxies in front of the app (default 1 in production)

# Server tests
TEST_DATABASE_URL=postgres://washlog:washlog@localhost:5434/washlog_test
