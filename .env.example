# Copy to .env for local development. Never commit a real .env.
# Values below match docker-compose.yml and are for local use only.

# Server
DATABASE_URL=postgres://washlog:washlog@localhost:5433/washlog
SYNC_TOKEN=change-me
PORT=8080
GIT_SHA=dev
DEMO_MODE=true

# Server tests
TEST_DATABASE_URL=postgres://washlog:washlog@localhost:5434/washlog_test

# Client (baked in at build time; must equal SYNC_TOKEN)
VITE_SYNC_TOKEN=change-me
